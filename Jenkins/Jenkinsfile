// Windows-compatible Jenkinsfile (sh -> bat)
// Infra (VPC, ALB, ECS, RDS, ECR) is already provisioned with Terraform from the local machine,
// so this pipeline only does: build -> scan -> push to ECR -> deploy to ECS -> smoke test.

// AWS access keys from the Jenkins credential "aws-credentials"
def AWS_BINDING = [[
    $class: 'AmazonWebServicesCredentialsBinding',
    credentialsId: 'aws-credentials',
    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
]]

pipeline {
    agent any

    environment {
        AWS_REGION      = 'ap-south-1'
        // CHANGED: plain string instead of credentials(...). An account ID is not a secret,
        // and this removes the "insecure interpolation of sensitive variables" warning.
        // Replace the value below with your 12-digit AWS account ID.
        AWS_ACCOUNT_ID  = 'REPLACE_WITH_12_DIGIT_ACCOUNT_ID'
        ECR_REGISTRY    = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_WEB_REPO    = "${ECR_REGISTRY}/myapp-dev-web"
        ECR_APP_REPO    = "${ECR_REGISTRY}/myapp-dev-app"
        IMAGE_TAG       = "${env.GIT_COMMIT.take(7)}"
        ECS_CLUSTER     = 'myapp-dev-cluster'
        ECS_WEB_SERVICE = 'myapp-dev-web-svc'
        ECS_APP_SERVICE = 'myapp-dev-app-svc'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
        timeout(time: 30, unit: 'MINUTES')   // NEW: stop hung builds
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Unit Tests') {
            parallel {
                stage('Web tier') {
                    steps {
                        dir('app/web') {
                            bat 'echo No unit tests configured for static web tier yet'
                        }
                    }
                }
                stage('App tier') {
                    steps {
                        dir('app/api') {
                            bat 'npm install'
                            bat 'npm test'
                        }
                    }
                }
            }
        }

        stage('Build Docker Images') {
            parallel {
                stage('Build web image') {
                    steps {
                        bat 'docker build -t %ECR_WEB_REPO%:%IMAGE_TAG% -t %ECR_WEB_REPO%:latest ./app/web'
                    }
                }
                stage('Build app image') {
                    steps {
                        bat 'docker build -t %ECR_APP_REPO%:%IMAGE_TAG% -t %ECR_APP_REPO%:latest ./app/api'
                    }
                }
            }
        }

        stage('Scan Images - Trivy') {
            parallel {
                stage('Scan web image') {
                    steps {
                        // To make the build FAIL on critical vulnerabilities, change --exit-code 0 to 1
                        // and --severity HIGH,CRITICAL to CRITICAL.
                        bat 'trivy image --cache-dir C:/trivy-cache --skip-db-update --exit-code 0 --severity HIGH,CRITICAL --format table -o trivy-web-report.txt %ECR_WEB_REPO%:%IMAGE_TAG%'
                        archiveArtifacts artifacts: 'trivy-web-report.txt', allowEmptyArchive: true
                    }
                }
                stage('Scan app image') {
                    steps {
                        bat 'trivy image --cache-dir C:/trivy-cache --skip-db-update --exit-code 0 --severity HIGH,CRITICAL --format table -o trivy-app-report.txt %ECR_APP_REPO%:%IMAGE_TAG%'
                        archiveArtifacts artifacts: 'trivy-app-report.txt', allowEmptyArchive: true
                    }
                }
            }
        }

        stage('Push to ECR') {
            steps {
                withCredentials(AWS_BINDING) {
                    bat '''
                        aws ecr get-login-password --region %AWS_REGION% | docker login --username AWS --password-stdin %ECR_REGISTRY% || exit /b 1
                        docker push %ECR_WEB_REPO%:%IMAGE_TAG% || exit /b 1
                        docker push %ECR_WEB_REPO%:latest || exit /b 1
                        docker push %ECR_APP_REPO%:%IMAGE_TAG% || exit /b 1
                        docker push %ECR_APP_REPO%:latest || exit /b 1
                    '''
                }
            }
        }

        stage('Deploy to ECS') {
            when { expression { env.GIT_BRANCH?.endsWith('main') } }
            steps {
                withCredentials(AWS_BINDING) {
                    bat '''
                        aws ecs update-service --cluster %ECS_CLUSTER% --service %ECS_WEB_SERVICE% --force-new-deployment --region %AWS_REGION% > nul || exit /b 1
                        aws ecs update-service --cluster %ECS_CLUSTER% --service %ECS_APP_SERVICE% --force-new-deployment --region %AWS_REGION% > nul || exit /b 1
                        aws ecs wait services-stable --cluster %ECS_CLUSTER% --services %ECS_WEB_SERVICE% %ECS_APP_SERVICE% --region %AWS_REGION% || exit /b 1
                    '''
                }
            }
        }

        stage('Smoke Test') {
            when { expression { env.GIT_BRANCH?.endsWith('main') } }
            steps {
                withCredentials(AWS_BINDING) {
                    script {
                        def albDns = bat(
                            script: '@aws elbv2 describe-load-balancers --names myapp-dev-public-alb --region %AWS_REGION% --query "LoadBalancers[0].DNSName" --output text',
                            returnStdout: true
                        ).trim()
                        // CHANGED: retry a few times in case the ALB needs a moment after deploy
                        retry(3) {
                            bat "curl -sf http://${albDns}/"
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            bat 'docker image prune -f || exit /b 0'
        }
        success {
            echo "Pipeline succeeded - image tag ${IMAGE_TAG} deployed"
        }
        failure {
            echo "Pipeline FAILED at tag ${IMAGE_TAG} - check Console Output"
        }
    }
}