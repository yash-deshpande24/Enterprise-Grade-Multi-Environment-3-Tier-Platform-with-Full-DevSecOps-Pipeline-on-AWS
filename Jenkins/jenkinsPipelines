// Windows-compatible Jenkinsfile (sh -> bat). Same stages as the original.

// AWS access keys from the Jenkins credential "aws-credentials"
def AWS_BINDING = [[
    $class: 'AmazonWebServicesCredentialsBinding',
    credentialsId: 'aws-credentials',
    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
]]

pipeline {
    agent any

    environment {
        AWS_REGION      = 'ap-south-1'
        AWS_ACCOUNT_ID  = credentials('aws-account-id')          // Jenkins credential (secret text)
        ECR_WEB_REPO    = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/myapp-dev-web"
        ECR_APP_REPO    = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/myapp-dev-app"
        IMAGE_TAG       = "${env.GIT_COMMIT.take(7)}"
        ECS_CLUSTER     = 'myapp-dev-cluster'
        ECS_WEB_SERVICE = 'myapp-dev-web-svc'
        ECS_APP_SERVICE = 'myapp-dev-app-svc'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Unit Tests') {
            parallel {
                stage('Web tier') {
                    steps {
                        dir('app/web') {
                            bat 'echo No unit tests configured for static web tier yet'
                        }
                    }
                }
                stage('App tier') {
                    steps {
                        dir('app/api') {
                            bat 'npm install'
                            bat 'npm test'
                        }
                    }
                }
            }
        }

        stage('Code Quality - SonarQube') {
            steps {
                withSonarQubeEnv('sonarqube-server') {
                    bat 'call sonar-scanner -Dsonar.projectKey=myapp-3tier -Dsonar.sources=app -Dsonar.host.url=%SONAR_HOST_URL% -Dsonar.login=%SONAR_AUTH_TOKEN%'
                }
            }
        }

        stage('Build Docker Images') {
            parallel {
                stage('Build web image') {
                    steps {
                        bat 'docker build -t %ECR_WEB_REPO%:%IMAGE_TAG% -t %ECR_WEB_REPO%:latest ./app/web'
                    }
                }
                stage('Build app image') {
                    steps {
                        bat 'docker build -t %ECR_APP_REPO%:%IMAGE_TAG% -t %ECR_APP_REPO%:latest ./app/api'
                    }
                }
            }
        }

        stage('Scan Images - Trivy') {
            parallel {
                stage('Scan web image') {
                    steps {
                        bat 'trivy image --exit-code 0 --severity HIGH,CRITICAL --format table -o trivy-web-report.txt %ECR_WEB_REPO%:%IMAGE_TAG%'
                        archiveArtifacts artifacts: 'trivy-web-report.txt', allowEmptyArchive: true
                    }
                }
                stage('Scan app image') {
                    steps {
                        bat 'trivy image --exit-code 0 --severity HIGH,CRITICAL --format table -o trivy-app-report.txt %ECR_APP_REPO%:%IMAGE_TAG%'
                        archiveArtifacts artifacts: 'trivy-app-report.txt', allowEmptyArchive: true
                    }
                }
            }
        }

        stage('Push to ECR') {
            steps {
                withCredentials(AWS_BINDING) {
                    bat '''
                        aws ecr get-login-password --region %AWS_REGION% | docker login --username AWS --password-stdin %AWS_ACCOUNT_ID%.dkr.ecr.%AWS_REGION%.amazonaws.com || exit /b 1
                        docker push %ECR_WEB_REPO%:%IMAGE_TAG% || exit /b 1
                        docker push %ECR_WEB_REPO%:latest || exit /b 1
                        docker push %ECR_APP_REPO%:%IMAGE_TAG% || exit /b 1
                        docker push %ECR_APP_REPO%:latest || exit /b 1
                    '''
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials(AWS_BINDING) {
                    dir('terraform/environments/dev') {
                        bat '''
                            terraform init -input=false || exit /b 1
                            terraform plan -input=false -out=tfplan || exit /b 1
                        '''
                    }
                }
            }
        }

        stage('Approval Gate') {
            when { expression { env.GIT_BRANCH?.endsWith('main') } }
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    input message: 'Apply Terraform changes and deploy to dev?', ok: 'Deploy'
                }
            }
        }

        stage('Terraform Apply') {
            when { expression { env.GIT_BRANCH?.endsWith('main') } }
            steps {
                withCredentials(AWS_BINDING) {
                    dir('terraform/environments/dev') {
                        bat 'terraform apply -input=false tfplan'
                    }
                }
            }
        }

        stage('Deploy to ECS') {
            when { expression { env.GIT_BRANCH?.endsWith('main') } }
            steps {
                withCredentials(AWS_BINDING) {
                    bat '''
                        aws ecs update-service --cluster %ECS_CLUSTER% --service %ECS_WEB_SERVICE% --force-new-deployment --region %AWS_REGION% || exit /b 1
                        aws ecs update-service --cluster %ECS_CLUSTER% --service %ECS_APP_SERVICE% --force-new-deployment --region %AWS_REGION% || exit /b 1
                        aws ecs wait services-stable --cluster %ECS_CLUSTER% --services %ECS_WEB_SERVICE% %ECS_APP_SERVICE% --region %AWS_REGION% || exit /b 1
                    '''
                }
            }
        }

        stage('Smoke Test') {
            when { expression { env.GIT_BRANCH?.endsWith('main') } }
            steps {
                withCredentials(AWS_BINDING) {
                    script {
                        def albDns = bat(
                            script: '@aws elbv2 describe-load-balancers --names myapp-dev-public-alb --region %AWS_REGION% --query "LoadBalancers[0].DNSName" --output text',
                            returnStdout: true
                        ).trim()
                        bat "curl -sf http://${albDns}/"
                    }
                }
            }
        }
    }

    post {
        failure {
            script {
                if (env.GIT_BRANCH?.endsWith('main')) {
                    echo 'Deployment failed - rolling back ECS services to previous task definition'
                    withCredentials(AWS_BINDING) {
                        bat '''
                            aws ecs update-service --cluster %ECS_CLUSTER% --service %ECS_WEB_SERVICE% --task-definition myapp-dev-web --region %AWS_REGION% || exit /b 0
                            aws ecs update-service --cluster %ECS_CLUSTER% --service %ECS_APP_SERVICE% --task-definition myapp-dev-app --region %AWS_REGION% || exit /b 0
                        '''
                    }
                }
            }
        }
        always {
            bat 'docker image prune -f || exit /b 0'
        }
        success {
            echo "Pipeline succeeded - image tag ${IMAGE_TAG} deployed"
        }
    }
}
